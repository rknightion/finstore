# Read only by the database container's first start and by the owner commands
# (`bootstrap`, `migrate`, `renormalise`). Keep this file at mode 600.

# The Postgres superuser's password, set when the data directory is first created.
POSTGRES_PASSWORD=CHANGE-ME-SUPERUSER

FINSTORE_SUPERUSER_DATABASE_URL=postgres://postgres:CHANGE-ME-SUPERUSER@finstore-db:5432/finstore?sslmode=disable
FINSTORE_OWNER_DATABASE_URL=postgres://finstore_owner:CHANGE-ME-OWNER@finstore-db:5432/finstore?sslmode=disable

# The passwords `bootstrap` sets on the two login roles. Use letters and digits only, or
# percent-encode them in the URLs above and in finstore.env.
FINSTORE_OWNER_PASSWORD=CHANGE-ME-OWNER
FINSTORE_APP_PASSWORD=CHANGE-ME-APP
