# Read only by the database container's first start and by the owner commands
# (`bootstrap`, `migrate`, `renormalise`). Keep this file at mode 600.

# The Postgres superuser's password, set when the data directory is first created.
POSTGRES_PASSWORD=CHANGE-ME-SUPERUSER

FINSTORE_SUPERUSER_DATABASE_URL=host=finstore-db port=5432 dbname=finstore user=postgres password=CHANGE-ME-SUPERUSER sslmode=disable
FINSTORE_OWNER_DATABASE_URL=host=finstore-db port=5432 dbname=finstore user=finstore_owner password=CHANGE-ME-OWNER sslmode=disable

# The passwords `bootstrap` sets on the two login roles. Use letters and digits only: the
# connection strings above and in finstore.env are space-separated key=value pairs, where a
# password with a space, a quote or a backslash would need quoting.
FINSTORE_OWNER_PASSWORD=CHANGE-ME-OWNER
FINSTORE_APP_PASSWORD=CHANGE-ME-APP

# Optional: the password `bootstrap` sets on the read-only finstore_mcp login, which an
# agent-facing endpoint connects as. Leave it empty and the role has no login (and `bootstrap`
# takes away a login it had). Letters and digits only, as above. Run `bootstrap` before `migrate`.
FINSTORE_MCP_PASSWORD=
