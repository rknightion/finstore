# The running service's settings. Keep this file at mode 600: it holds secrets.
# docs/operations.md lists every variable and its default.

# The finstore_app role. The password is the one `bootstrap` set from owner.env.
FINSTORE_DATABASE_URL=host=finstore-db port=5432 dbname=finstore user=finstore_app password=CHANGE-ME-APP sslmode=disable

# The address users reach the service at. The Monzo redirect URL is this plus /callback/monzo.
FINSTORE_PUBLIC_URL=https://finstore.example.test
# Who may use the pages: the addresses your sign-in proxy passes in FINSTORE_AUTH_HEADER.
FINSTORE_ALLOWED_EMAILS=you@example.com
FINSTORE_AUTH_HEADER=X-Auth-Request-Email

# The OAuth client from https://developers.monzo.com (a confidential client).
FINSTORE_MONZO_CLIENT_ID=oauth2client_CHANGE-ME
FINSTORE_MONZO_CLIENT_SECRET=CHANGE-ME

FINSTORE_TIMEZONE=Europe/London
FINSTORE_DUMP_STATUS_FILE=/var/lib/finstore/status/dump.json

# Optional: OTLP metrics and logs over HTTP with basic auth. Export is off when the endpoint is empty.
FINSTORE_OTLP_ENDPOINT=
FINSTORE_OTLP_INSTANCE_ID=
FINSTORE_OTLP_TOKEN=
FINSTORE_ENVIRONMENT=prod
FINSTORE_LOG_LEVEL=info
