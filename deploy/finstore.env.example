# The running service's settings. Keep this file at mode 600: it holds secrets.
# docs/operations.md lists every variable and its default.

# The finstore_app role. The password is the one `bootstrap` set from owner.env.
FINSTORE_DATABASE_URL=host=finstore-db port=5432 dbname=finstore user=finstore_app password=CHANGE-ME-APP sslmode=disable

# The address users reach the service at. The Monzo redirect URL is this plus /callback/monzo.
# With the Tailscale sidecar it is https:// plus the node's MagicDNS name.
FINSTORE_PUBLIC_URL=https://CHANGE-ME
# Who may use the pages: tailnet login names with the sidecar, or the addresses a sign-in proxy
# passes (set FINSTORE_AUTH_HEADER to its header, often X-Auth-Request-Email).
FINSTORE_ALLOWED_EMAILS=you@example.com
FINSTORE_AUTH_HEADER=Tailscale-User-Login

# The OAuth client from https://developers.monzo.com (a confidential client).
FINSTORE_MONZO_CLIENT_ID=oauth2client_CHANGE-ME
FINSTORE_MONZO_CLIENT_SECRET=CHANGE-ME

# Optional: a TrueLayer Data API client, for the Lloyds and Monzo-through-TrueLayer connections.
# Set both to enable TrueLayer; left empty, the service runs Monzo only (one without the other
# stops the service at start). Its redirect URI is FINSTORE_PUBLIC_URL plus /callback/truelayer.
# The two URLs default to TrueLayer's live hosts.
FINSTORE_TRUELAYER_CLIENT_ID=
FINSTORE_TRUELAYER_CLIENT_SECRET=
FINSTORE_TRUELAYER_AUTH_URL=https://auth.truelayer.com
FINSTORE_TRUELAYER_API_URL=https://api.truelayer.com

# Optional: the MCP endpoint at /mcp, for agents on the tailnet. It is served only when both are set.
# The URL is a libpq connection string for the finstore_mcp login (its password is set by bootstrap
# from FINSTORE_MCP_PASSWORD in owner.env); serve refuses to start when it logs in as another role.
# The capability is the app capability your tailnet policy grants the callers, and the same name is
# in AcceptAppCaps in ts/tailscale-serve.json. It is a name, not a secret.
FINSTORE_MCP_DATABASE_URL=
FINSTORE_MCP_APP_CAP=

FINSTORE_TIMEZONE=Europe/London
FINSTORE_DUMP_STATUS_FILE=/var/lib/finstore/status/dump.json

# Optional: OTLP metrics and logs over HTTP with basic auth. Export is off when the endpoint is empty.
FINSTORE_OTLP_ENDPOINT=
FINSTORE_OTLP_INSTANCE_ID=
FINSTORE_OTLP_TOKEN=
FINSTORE_ENVIRONMENT=prod
FINSTORE_LOG_LEVEL=info
